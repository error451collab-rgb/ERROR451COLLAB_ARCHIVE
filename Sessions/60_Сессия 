        return 1
    fi
    
    current=$(cat "$SESSION_FILE")
    new=$((current + 1))
    echo "$new" > "$SESSION_FILE"
    
    # Прогресс-бар в терминале
    echo -e "\n${BLUE}=== ДИАЛОГ $new/$MAX_DIALOGS ===${NC}"
    
    # Проверка порогов
    case $new in
        65)
            echo -e "${YELLOW}⚠️  Использовано 85% (65/76 диалогов)${NC}"
            notify-send -i "dialog-warning" "ERROR451 - Предупреждение" "Использовано 85% сессии\nОсталось: 11 диалогов"
            ;;
        70)
            echo -e "${YELLOW}🔔 Осталось 6 диалогов до лимита${NC}"
            notify-send -i "dialog-warning" "ERROR451 - Внимание" "Начинайте подготовку к архивации\nОсталось: 6 диалогов"
            ;;
        74)
            echo -e "${RED}🚨 КРИТИЧЕСКОЕ ПРЕДУПРЕЖДЕНИЕ!${NC}"
            echo -e "${RED}Немедленная архивация! Последние 2 диалога!${NC}"
            notify-send -i "dialog-error" "ERROR451 - КРИТИЧЕСКО" "Немедленная архивация!\nОсталось: 2 диалога до лимита"
            ;;
        76)
            echo -e "${RED}❌ ЛИМИТ ДОСТИГНУТ. СЕССИЯ ЗАВЕРШЕНА${NC}"
            notify-send -i "process-stop" "ERROR451 - Лимит" "Сессия завершена\nДостигнут лимит в 76 диалогов"
            ;;
        *)
            # Отображение прогресса каждые 5 диалогов
            if (( $new % 5 == 0 )); then
                echo -e "${GREEN}Прогресс: $new/$MAX_DIALOGS диалогов${NC}"
            fi
            ;;
    esac
    
    # Всегда показываем оставшееся количество после 65
    if [ $new -ge 65 ] && [ $new -lt 76 ]; then
        remaining=$((76 - new))
        echo -e "Осталось диалогов: $remaining"
    fi
}

# Функция статуса
show_status() {
    if [ ! -f "$SESSION_FILE" ]; then
        echo "Сессия не инициализирована"
        return 1
    fi
    
    current=$(cat "$SESSION_FILE")
    remaining=$((MAX_DIALOGS - current))
    percentage=$((current * 100 / MAX_DIALOGS))
    
    echo -e "\n${BLUE}📊 СТАТУС СЕССИИ${NC}"
    echo -e "Текущий диалог: $current/$MAX_DIALOGS"
    echo -e "Осталось: $remaining диалогов"
    echo -e "Заполнено: ${percentage}%"
    
    # Графический индикатор
    bar="["
    for i in $(seq 1 20); do
        if [ $i -le $((percentage / 5)) ]; then
            bar="${bar}█"
        else
            bar="${bar}░"
        fi
    done
    bar="${bar}]"
    echo -e "Прогресс: $bar"
}

# Функция аварийного архивирования
emergency_archive() {
    current=$(cat "$SESSION_FILE" 2>/dev/null || echo "0")
    echo -e "${YELLOW}🆘 АВАРИЙНОЕ АРХИВИРОВАНИЕ${NC}"
    echo -e "Текущий диалог: $current"
    echo -e "Создаю снапшот сессии..."
    
    timestamp=$(date +"%Y%m%d_%H%M%S")
    archive_file="$HOME/ERROR451/emergency_archive_${timestamp}.txt"
    
    echo "Аварийный архив сессии на диалоге $current" > "$archive_file"
    echo "Время: $(date)" >> "$archive_file"
    
    echo -e "${GREEN}✅ Снапшот сохранён: $archive_file${NC}"
    notify-send -i "document-save" "ERROR451 - Аварийный архив" "Создан снапшот на диалоге $current"
}

# Основной switch
case "${1}" in
    "init")
        init_session
        ;;
    "add")
        add_dialog
        ;;
    "status")
        show_status
        ;;
    "panic")
        emergency_archive
        ;;
    *)
        echo -e "${BLUE}ERROR451 Session Monitor v1.0${NC}"
        echo -e "Использование: $0 {команда}"
        echo -e "\nКоманды:"
        echo -e "  init    - Начать новую сессию"
        echo -e "  add     - Добавить диалог (+1)"
        echo -e "  status  - Показать статус"
        echo -e "  panic   - Аварийное архивирование"
        echo -e "\nПример:"
        echo -e "  $0 init   # Начать сессию"
        echo -e "  $0 add    # После каждого диалога"
        ;;
esac
```

