#!/bin/bash
# session_monitor.sh - Монитор сессий ERROR451 v1.0

# Конфигурация
SESSION_FILE="$HOME/ERROR451/current_session_count"
MAX_DIALOGS=76

# Цвета для терминала
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Функция инициализации новой сессии
init_session() {
    echo "0" > "$SESSION_FILE"
    echo -e "${GREEN}✅ Новая сессия инициализирована${NC}"
    echo -e "Лимит: $MAX_DIALOGS диалогов"
    notify-send -i "dialog-information" "ERROR451" "Новая сессия начата. Лимит: $MAX_DIALOGS диалогов"
}

# Функция увеличения счётчика
add_dialog() {
