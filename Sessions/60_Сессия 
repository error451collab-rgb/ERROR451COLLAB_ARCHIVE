**Техническая реализация (простая):**
```bash
#!/bin/bash
# monitor.sh

COUNTER_FILE="current_session_count.txt"
MAX_DIALOGS=76

# Инициализация
echo "0" > $COUNTER_FILE

# Функция увеличения счётчика
add_dialog() {
    current=$(cat $COUNTER_FILE)
    new=$((current + 1))
    echo $new > $COUNTER_FILE
    
    if [ $new -eq 65 ]; then
        echo "⚠️  ПРЕДУПРЕЖДЕНИЕ: Осталось 10 диалогов до архивации"
    elif [ $new -eq 70 ]; then
        echo "🔔 СРОЧНО: Начинайте архивацию (диалог 70/76)"
    elif [ $new -ge 76 ]; then
        echo "🛑 ЛИМИТ ДОСТИГНУТ: Сессия завершена"
    fi
    
    # Прогресс-бар
    progress=$((new * 10 / MAX_DIALOGS))
    bar="["
    for i in {1..10}; do
        if [ $i -le $progress ]; then
            bar="${bar}="
        else
            bar="${bar} "
        fi
    done
    bar="${bar}]"
    echo "$bar $new/$MAX_DIALOGS диалогов"
}
```

